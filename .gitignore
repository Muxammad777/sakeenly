# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Islamic knowledge corpus — 293 MB / 1,426 files of tafsir +
# hadith pulled from public APIs. Lazy-loaded server-side only; we
# keep them out of git. The small Quran subset (~4 MB, used by the
# build-time search corpus) is force-included below.
lib/knowledge/*
!lib/knowledge/quran/
!lib/knowledge/MANIFEST.md

