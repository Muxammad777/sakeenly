# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Islamic knowledge corpus — 293 MB / 1,426 files of tafsir +
# hadith pulled from public APIs. Lazy-loaded server-side only; we
# keep them out of git. The small Quran subset (~4 MB, used by the
# build-time search corpus) is force-included below.
lib/knowledge/*
!lib/knowledge/quran/
!lib/knowledge/MANIFEST.md
# Tajweed corpus from cpfair/quran-tajweed (Public Domain Tanzil
# annotations). ~5 MB JSON, used by the colored-tajweed reader mode.
# Translations used by the search corpus — checked in selectively.
!lib/knowledge/translations/
lib/knowledge/translations/*
!lib/knowledge/translations/ru_elmirkuliev.json
!lib/knowledge/translations/ru_abuadel.json
!lib/knowledge/translations/en_sahih_international.json
!lib/knowledge/translations/en_mustafakhattabg.json
!lib/knowledge/translations/ur_abulaalamaududi.json
!lib/knowledge/translations/ur_fatehmuhammadja.json
!lib/knowledge/translations/ur_junagarhi.json
!lib/knowledge/translations/ms_abdullahmuhamma.json
!lib/knowledge/translations/hi_suhelfarooqkhan.json
!lib/knowledge/translations/hi_farooq.json
!lib/knowledge/translations/id_indonesianislam.json
!lib/knowledge/translations/id_muntakhab.json
!lib/knowledge/translations/id_jalalayn.json
# Tafsir corpora needed by the reader's Tafsir toggle. Two most-cited
# authors (Ibn Kathir + As-Saadi) in the languages we serve. ~73MB total.
!lib/knowledge/tafsir/
lib/knowledge/tafsir/*
!lib/knowledge/tafsir/ar-tafsir-ibn-kathir/
!lib/knowledge/tafsir/en-tafisr-ibn-kathir/
!lib/knowledge/tafsir/ur-tafseer-ibn-e-kaseer/
!lib/knowledge/tafsir/ar-tafseer-al-saddi/
!lib/knowledge/tafsir/ru-tafseer-al-saddi/
!lib/knowledge/tafsir/ur-tafseer-al-saddi/
!lib/knowledge/tafsir/id-tafseer-al-saddi/
!lib/knowledge/tafsir/fa-tafseer-al-saddi/
!lib/knowledge/tafsir/ar-tafsir-al-jalalayn/
!lib/knowledge/tafsir/en-al-jalalayn/
!lib/knowledge/tafsir/ar-tafsir-muyassar/
# Loader module — must be checked in or the /api/tafsir endpoint can't
# be built on Railway. The lib/knowledge/* glob above ate it on the
# previous commit; explicitly allowlist.
!lib/knowledge/tafsir.ts

