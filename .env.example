# ─── AI ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ─── Database ──────────────────────────────────────────────────────────────
# Supabase free tier — Project Settings → Database → Connection string (URI).
# For local dev use the "Direct connection" string; for Vercel use "Pooler" + a
# separate DIRECT_URL for Prisma migrations.
DATABASE_URL=postgresql://user:password@host:5432/sakeenly?schema=public

# ─── NextAuth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32  (or use any 32+ char random string)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (optional in dev, required for prod) — see https://authjs.dev/getting-started/providers/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Email magic-link (Resend / SendGrid SMTP)
EMAIL_SERVER=smtp://user:pass@smtp.resend.com:465
EMAIL_FROM=hello@sakeenly.com

# ─── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=

# ─── External APIs ─────────────────────────────────────────────────────────
QURAN_API_URL=https://api.quran.com/api/v4
SUNNAH_API_URL=https://api.sunnah.com/v1
SUNNAH_API_KEY=

# ─── Analytics (optional, privacy-first only) ──────────────────────────────
# Plausible OR self-hosted PostHog — NEVER GA / FB Pixel / third-party ads.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
