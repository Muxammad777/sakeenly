    "c10": {
      "d": "\"Allah is enough for us — and He is the best Disposer of affairs.\"",
      "t": "When you feel afraid"
    },
    "c11": {
      "d": "Those who restrain their anger — Allah loves them.",
      "t": "When anger rises"
    },
    "c12": {
      "d": "The hearts of the believers tremble at the remembrance of Allah.",
      "t": "To strengthen iman"
    },
    "c13": {
      "d": "The du'a of Ayyub ﷺ: \"Hardship has touched me, and You are the Most Merciful.\"",
      "t": "When you're unwell"
    },
    "c14": {
      "d": "\"Indeed, to Allah we belong, and to Him we shall return.\"",
      "t": "When you lose a loved one"
    },
    "c15": {
      "d": "\"My Lord, have mercy on them as they raised me when I was small.\"",
      "t": "Ayat about parents"
    },
    "c16": {
      "d": "The du'a of Zakariyya ﷺ: \"Grant me from Yourself a goodly offspring.\"",
      "t": "Ayat about children"
    },
    "c17": {
      "d": "\"Whoever fears Allah, He makes a way out for him.\"",
      "t": "When money is tight"
    },
    "c18": {
      "d": "Doubt becomes dangerous when you keep silent about it.",
      "t": "When doubt creeps in"
    },
    "c19": {
      "d": "\"Glory be to Him who subjected this to us.\"",
      "t": "Before a journey"
    },
    "c2": {
      "d": "Sabr is holding the heart back from complaint. Allah is with the patient.",
      "t": "Ayat on sabr (patience)"
    },
    "c20": {
      "d": "Allah will replace evil deeds with good ones.",
      "t": "To walk away from a sin"
    },
    "c21": {
      "d": "\"Whoever places his trust in Allah, He is enough for him.\"",
      "t": "On tawakkul (trust)"
    },
    "c22": {
      "d": "\"Call upon Me — I will respond to you.\"",
      "t": "Asking Allah for help"
    },
    "c23": {
      "d": "If Shaytan whispers — take refuge in Allah.",
      "t": "When temptation comes"
    },
    "c24": {
      "d": "\"Let them rejoice in the mercy of Allah.\"",
      "t": "For joy"
    },
    "c25": {
      "d": "Surah Al-Kahf — light between two Fridays.",
      "t": "Ayat for Friday"
    },
    "c26": {
      "d": "The month in which the Quran was revealed.",
      "t": "Ayat of Ramadan"
