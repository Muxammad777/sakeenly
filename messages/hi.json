    "c18": {
      "d": "Doubt becomes dangerous when you keep silent about it.",
      "t": "When doubt creeps in"
    },
    "c19": {
      "d": "\"Glory be to Him who subjected this to us.\"",
      "t": "Before a journey"
    },
    "c2": {
      "d": "Sabr is holding the heart back from complaint. Allah is with the patient.",
      "t": "Ayat on sabr (patience)"
    },
    "c20": {
      "d": "Allah will replace evil deeds with good ones.",
      "t": "To walk away from a sin"
